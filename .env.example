# URL pubblica del sito, usata per canonical, Open Graph e sitemap.
# In produzione (Vercel): https://guidarsa.it
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — progetto che ospita la tabella `strutture`.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Chiave anon: sola lettura dei dati pubblici, può stare nel bundle client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service role: SOLO in locale, per gli script di import e arricchimento.
# Non va caricata su Vercel: il sito legge con la chiave anon attraverso la
# policy RLS strutture_lettura_pubblica. Mai esposta al browser, mai in un commit.
SUPABASE_SERVICE_ROLE_KEY=

# Strato di conversione: "1" accende wizard e CTA.
NEXT_PUBLIC_CONVERSIONE_ATTIVA=0

# Notifiche di nuove richieste (rotta /api/notifica, chiamata dal webhook di Supabase).
# Segreto condiviso fra Supabase e Vercel: qualsiasi stringa lunga a caso.
NOTIFICA_SEGRETO=
# Canale Telegram: gratuito, immediato, nessun DNS. Bastano queste due.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Link che la notifica mette in fondo al messaggio. Se vuoto viene composto da
# NEXT_PUBLIC_SUPABASE_URL e punta alla tabella nella dashboard di Supabase:
# nel messaggio finiscono solo nome e zona, i recapiti si leggono di la.
NOTIFICA_DASHBOARD_URL=
# Canale email, facoltativo: richiede un dominio verificato su Resend.
RESEND_API_KEY=
NOTIFICA_EMAIL_A=
NOTIFICA_EMAIL_DA=
